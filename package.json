{
	"name": "omdn",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"imports": {
		"#server/*": "./server/*.js"
	},
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:headed": "playwright test --headed",
		"test:ssr": "npm run build && playwright test --config playwright.ssr.config.js",
		"dev": "react-router dev",
		"dev:server": "node --env-file=.env.development --watch server/server.js",
		"build": "react-router build",
		"prestart": "npm run build",
		"start": "node server/server.js",
		"lint": "eslint .",
		"diagram": "node scripts/dev/generate-dependency-graphs.js",
		"diagram:validate": "depcruise src server --include-only \"^(src|server)\" --output-type err",
		"logic-map": "node scripts/dev/generate-logic-map.js",
		"maps": "npm run diagram && npm run logic-map",
		"diagram:all": "npm run diagram && npm run logic-map",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check:all": "node scripts/dev/run-all.js",
		"smoke:auth": "node --env-file=.env.development scripts/dev/auth-smoke-test.js",
		"db:clear": "node --env-file=.env.development scripts/dev/clear-database.js",
		"generate:secrets": "node scripts/dev/generate-secrets.js"
	},
	"dependencies": {
		"@base-ui/react": "^1.6.0",
		"@react-router/express": "8.3.0",
		"@shadcn/react": "^0.2.1",
		"@tailwindcss/vite": "^4.3.3",
		"argon2": "^0.45.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.4.0",
		"dotenv": "^17.4.2",
		"embla-carousel-react": "^8.6.0",
		"express": "^5.2.1",
		"express-mysql-session": "^3.0.3",
		"express-rate-limit": "^8.6.1",
		"express-session": "^1.19.0",
		"input-otp": "^1.4.2",
		"isbot": "^5",
		"lucide-react": "^1.27.0",
		"mysql2": "^3.23.2",
		"otplib": "^13.4.1",
		"qrcode": "^1.5.4",
		"react": "^19.2.7",
		"react-day-picker": "^10.0.1",
		"react-dom": "^19.2.7",
		"react-resizable-panels": "^4.12.2",
		"react-router": "8.3.0",
		"recharts": "^3.8.0",
		"shadcn": "^4.16.0",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@react-router/dev": "8.3.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"dependency-cruiser": "^18.1.0",
		"eslint": "^10.6.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.3",
		"globals": "^17.7.0",
		"prettier": "^3.9.6",
		"supertest": "^7.2.2",
		"vite": "^8.1.1",
		"vitest": "^4.1.10"
	},
	"allowScripts": {
		"argon2@0.45.1": true
	},
	"engines": {
		"node": ">=22.22.0",
		"npm": ">=10"
	}
}
